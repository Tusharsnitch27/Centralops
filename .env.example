# --- PostgreSQL ---
DATABASE_URL=postgres://user:pass@host:5432/centralops
# Seed realistic demo data (tasks, projects, meetings; AOP + S&OP from the FY26-27 workbooks) on first start when the DB is empty
SEED_DEMO=true

# --- Auth ---
# Session-signing secret (≥32 random characters)
NEXTAUTH_SECRET=
# Public URL (https → Secure cookies; also used for the Google OAuth redirect)
NEXTAUTH_URL=https://centralops.snitch-workflow.com
# First admin account, created on first start (password is then managed in the app)
ADMIN_PASSWORD=
ADMIN_EMAIL=tushar@snitch.com
SESSION_HOURS=12
# Local development only: AUTH_MODE=dev signs you in as the admin automatically (ignored in production)
AUTH_MODE=

# --- Google Calendar sync (optional integration; sign-in is email + password only). OAuth client (Web) in Google Cloud Console,
# redirect URI: <NEXTAUTH_URL>/api/integrations/google/callback ; enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (MoM processing, assistant, summaries) ---
# snowflake: Claude via Snowflake Cortex using SNOWFLAKE_ACCOUNT + SNOWFLAKE_PAT (no separate key)
# anthropic: api.anthropic.com with ANTHROPIC_API_KEY
# Without either, Central Ops falls back to its built-in rule-based extraction.
AI_PROVIDER=snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Manpower (attendance app read-only API, pulled daily 08:00 IST). Values come from the attendance app's token file — load via Coolify secrets, never chat/Git.
ATTENDANCE_API_BASE_URL=https://wh-attendance.snitch-workflow.com
MANPOWER_API_PATH=/api/v1/integrations/manpower
ATTENDANCE_MANPOWER_API_TOKEN=
MANPOWER_TOKEN_ID=
